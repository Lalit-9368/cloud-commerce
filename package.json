{
  "name": "cloud-commerce-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["frontend", "auth-service", "checkout-service", "payment-service", "packages/*"],
  "scripts": {
    "dev": "concurrently \"npm:dev:frontend\" \"npm:dev:auth\" \"npm:dev:checkout\" \"npm:dev:payment\"",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:auth": "npm --workspace auth-service run dev",
    "dev:checkout": "npm --workspace checkout-service run dev",
    "dev:payment": "npm --workspace payment-service run dev"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
